{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bead",
  "version": "0.1.0",
  "identifier": "dev.bead.app",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bead",
        "width": 420,
        "height": 300,
        "x": 1180,
        "y": 300,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
