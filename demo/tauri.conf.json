{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bead-probe",
  "version": "0.0.0",
  "identifier": "dev.bead.probe",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "bead-probe",
        "width": 320,
        "height": 120,
        "x": 900,
        "y": 360,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
